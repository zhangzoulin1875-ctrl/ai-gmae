generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  discordId      String?  @unique
  username       String
  avatar         String?
  isAdmin        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  players        Player[]
}

model GameRoom {
  id              String        @id @default(uuid())
  name            String
  status          String        @default("WAITING")
  currentTurn     Int           @default(0)
  turnIntervalHrs Int           @default(2)
  lastTurnAt      DateTime?
  nextTurnAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  players         Player[]
  orders          Order[]
  resolutions     TurnResolution[]
  countryStates   CountryState[]
}

model Player {
  id            String   @id @default(uuid())
  userId        String
  gameId        String
  countryId    String
  isReady      Boolean  @default(false)
  isAI         Boolean  @default(false)
  aiPersonality String?
  status        String   @default("ACTIVE")
  joinedAt      DateTime @default(now())
  user          User       @relation(fields: [userId], references: [id])
  game          GameRoom   @relation(fields: [gameId], references: [id])

  @@unique([gameId, countryId])
}

model CountryState {
  id            String   @id @default(uuid())
  gameId        String
  countryId     String
  turn          Int
  infantry      Int      @default(0)
  artillery     Int      @default(0)
  cavalry       Int      @default(0)
  morale        Int      @default(50)
  gold          Int      @default(100)
  industry      Int      @default(10)
  manpower      Int      @default(1000)
  stability      Int      @default(50)
  territories   String[]
  isAIControlled Boolean @default(false)
  playerId      String?
  createdAt     DateTime @default(now())
  game          GameRoom @relation(fields: [gameId], references: [id])

  @@unique([gameId, countryId, turn])
}

model Order {
  id              String   @id @default(uuid())
  gameId          String
  playerId        String
  countryId       String
  turn            Int
  type            String
  fromTerritoryId String?
  targetTerritoryId String?
  infantry        Int?
  artillery       Int?
  cavalry         Int?
  details         String?
  status          String   @default("PENDING")
  isAIOrder       Boolean  @default(false)
  createdAt       DateTime @default(now())
  game            GameRoom @relation(fields: [gameId], references: [id])
}

model TurnResolution {
  id              String   @id @default(uuid())
  gameId          String
  turn            Int
  resolvedAt      DateTime @default(now())
  narrative       String
  resolvedByProvider String
  executionTimeMs Int
  apiTokensUsed   Int      @default(0)
  game            GameRoom @relation(fields: [gameId], references: [id])

  @@unique([gameId, turn])
}

model AIProviderConfig {
  id            String   @id @default(uuid())
  name          String
  type          String
  apiKeyEnc     String?
  endpoint      String?
  model         String
  priority      Int
  isEnabled     Boolean  @default(true)
  timeoutMs     Int      @default(30000)
  maxRetries    Int      @default(2)
  temperature   Float    @default(0.7)
  systemPrompt  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomUnit {
  id            String   @id @default(uuid())
  gameId        String?
  category      String   // infantry | cavalry | artillery | fleet | armored
  nameZh        String
  nameEn        String?
  description   String?
  // Combat stats
  attack        Int      @default(10)
  defense       Int      @default(10)
  speed         Int      @default(5)
  range_        Int      @default(1)
  // Recruitment cost
  costGold      Int      @default(50)
  costManpower  Int      @default(10000)
  costIndustry  Int      @default(5)
  // Metadata
  prompt        String?
  isApproved    Boolean  @default(true)
  createdAt     DateTime @default(now())
  // Designer attribution — every unit is now designed by a player, not the admin
  designedByUserId    String?
  designedByUsername  String?
  designedByCountryId String?

  @@map("custom_units")
}

model UnitDesignRule {
  id              String   @id @default(uuid())
  era             String   @default("1914")
  maxPerCategory  Int      @default(5)
  // Stat caps
  maxAttack       Int      @default(100)
  maxDefense      Int      @default(100)
  maxSpeed        Int      @default(50)
  maxRange        Int      @default(10)
  minCostGold     Int      @default(10)
  minCostManpower Int      @default(1000)
  minCostIndustry Int      @default(1)
  // Forbidden technologies (newline-separated)
  forbiddenTechs  String   @default("nuclear,atomic,nuke,missile,ballistic,jet,satellite,computer,drone,laser,stealth,cyber,radar,sonar,submarine-launched,ICBM,smart bomb,GPS")
  // Allowed tech keywords (whitelist hint for AI)
  allowedEra      String   @default("bolt-action rifle,machine gun,artillery cannon,cavalry horse,steam ship,dreadnought,zeppelin,early tank,biplane,trench,barbed wire,gas,flamethrower")
  updatedAt       DateTime @updatedAt

  @@map("unit_design_rules")
}
